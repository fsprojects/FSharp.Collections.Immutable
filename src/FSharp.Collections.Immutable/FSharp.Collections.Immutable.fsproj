<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>$(AssemblyBaseName)</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>FSharp.Collections.Immutable</PackageId>
    <Title>FSharp.Collections.Immutable</Title>
    <Description>F# bindings for System.Collections.Immutable</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <Tailcalls>true</Tailcalls>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests call internal algorithms directly, where reaching a case through a public function would need arrays
         too large for memory (the bounds of the chunks of a parallel loop, for example) -->
    <InternalsVisibleTo Include="$(AssemblyBaseName).Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Helper\ImmutableCollectionUtil.fs" />
    <Compile Include="Helper\Comparers.fs" />
    <Compile Include="Helper\ErrorStrings.fs" />
    <Compile Include="Helper\Raise.fs" />
    <Compile Include="Helper\ArrayChecks.fs" />
    <Compile Include="Helper\Arrays.fs" />
    <Compile Include="Helper\ParallelArrays.fs" />
    <Compile Include="Helper\Sets.fs" />
    <Compile Include="Helper\HashSets.fs" />
    <Compile Include="FlatList\FlatListTypes.fs" />
    <Compile Include="FlatList\FlatList.fsi" />
    <Compile Include="FlatList\FlatList.fs" />
    <Compile Include="FlatList\FlatListOption.fsi" />
    <Compile Include="FlatList\FlatListOption.fs" />
    <Compile Include="FlatList\FlatListTuple.fsi" />
    <Compile Include="FlatList\FlatListTuple.fs" />
    <Compile Include="FlatList\FlatListBuilder.fsi" />
    <Compile Include="FlatList\FlatListBuilder.fs" />
    <Compile Include="FlatList\FlatListCE.fsi" />
    <Compile Include="FlatList\FlatListCE.fs" />
    <Compile Include="HashSet\HashSetTypes.fs" />
    <Compile Include="HashSet\HashSet.CustomComparer.fsi">
      <DependentUpon>HashSet.fsi</DependentUpon>
    </Compile>
    <Compile Include="HashSet\HashSet.CustomComparer.fs">
      <DependentUpon>HashSet.fs</DependentUpon>
    </Compile>
    <Compile Include="HashSet\HashSet.fsi" />
    <Compile Include="HashSet\HashSet.fs" />
    <Compile Include="HashSet\HashSetOption.fsi" />
    <Compile Include="HashSet\HashSetOption.fs" />
    <Compile Include="HashSet\HashSetTuple.fsi" />
    <Compile Include="HashSet\HashSetTuple.fs" />
    <Compile Include="HashSet\ISet.fsi" />
    <Compile Include="HashSet\ISet.fs" />
    <Compile Include="HashSet\ISetOption.fsi" />
    <Compile Include="HashSet\ISetOption.fs" />
    <Compile Include="HashSet\ISetTuple.fsi" />
    <Compile Include="HashSet\ISetTuple.fs" />
    <Compile Include="HashSet\HashSetCE.fsi" />
    <Compile Include="HashSet\HashSetCE.fs" />
    <Compile Include="FrozenSet\FrozenSet.CustomComparer.fsi">
      <DependentUpon>FrozenSet.fsi</DependentUpon>
    </Compile>
    <Compile Include="FrozenSet\FrozenSet.CustomComparer.fs">
      <DependentUpon>FrozenSet.fs</DependentUpon>
    </Compile>
    <Compile Include="FrozenSet\FrozenSet.fsi" />
    <Compile Include="FrozenSet\FrozenSet.fs" />
    <Compile Include="FrozenSet\FrozenSetOption.fsi" />
    <Compile Include="FrozenSet\FrozenSetOption.fs" />
    <Compile Include="FrozenSet\FrozenSetTuple.fsi" />
    <Compile Include="FrozenSet\FrozenSetTuple.fs" />
    <Compile Include="FrozenSet\FrozenSetCE.fsi" />
    <Compile Include="FrozenSet\FrozenSetCE.fs" />
    <Compile Include="Stack.fs" />
    <Compile Include="ImmutableList.fs" />
    <Compile Include="Queue.fs" />
    <Compile Include="IndexedSeq.fs" />
    <Compile Include="Maps.fs" />
    <Compile Include="Sets.fs" />
    <Compile Include="ComputationExpressions.fsi" />
    <Compile Include="ComputationExpressions.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Collections.Immutable" />
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
