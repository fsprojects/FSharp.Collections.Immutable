<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>$(AssemblyBaseName)</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>FSharp.Collections.Immutable</PackageId>
    <Title>FSharp.Collections.Immutable</Title>
    <Description>F# bindings for System.Collections.Immutable</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <Tailcalls>true</Tailcalls>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests call internal algorithms directly, where reaching a case through a public function would need arrays
         too large for memory (the bounds of the chunks of a parallel loop, for example) -->
    <InternalsVisibleTo Include="$(AssemblyBaseName).Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Helper\ImmutableCollectionUtil.fs" />
    <Compile Include="Helper\Comparers.fs" />
    <Compile Include="Helper\ErrorStrings.fs" />
    <Compile Include="Helper\Raise.fs" />
    <Compile Include="Helper\ArrayChecks.fs" />
    <Compile Include="Helper\Arrays.fs" />
    <Compile Include="Helper\ParallelArrays.fs" />
    <Compile Include="Helper\Dictionaries.fs" />
    <Compile Include="FlatList\FlatListTypes.fs" />
    <Compile Include="FlatList\FlatList.fsi" />
    <Compile Include="FlatList\FlatList.fs" />
    <Compile Include="FlatList\FlatListOption.fsi" />
    <Compile Include="FlatList\FlatListOption.fs" />
    <Compile Include="FlatList\FlatListTuple.fsi" />
    <Compile Include="FlatList\FlatListTuple.fs" />
    <Compile Include="FlatList\FlatListBuilder.fsi" />
    <Compile Include="FlatList\FlatListBuilder.fs" />
    <Compile Include="FlatList\FlatListCE.fsi" />
    <Compile Include="FlatList\FlatListCE.fs" />
    <Compile Include="HashMap\HashMapTypes.fs" />
    <Compile Include="HashMap\HashMap.CustomComparers.fsi">
      <DependentUpon>HashMap.fsi</DependentUpon>
    </Compile>
    <Compile Include="HashMap\HashMap.CustomComparers.fs">
      <DependentUpon>HashMap.fs</DependentUpon>
    </Compile>
    <Compile Include="HashMap\HashMap.fsi" />
    <Compile Include="HashMap\HashMap.fs" />
    <Compile Include="HashMap\HashMapOption.fsi" />
    <Compile Include="HashMap\HashMapOption.fs" />
    <Compile Include="HashMap\HashMapTuple.fsi" />
    <Compile Include="HashMap\HashMapTuple.fs" />
    <Compile Include="HashMap\HashMap.Extensions.fsi">
      <DependentUpon>HashMap.fsi</DependentUpon>
    </Compile>
    <Compile Include="HashMap\HashMap.Extensions.fs">
      <DependentUpon>HashMap.fs</DependentUpon>
    </Compile>
    <Compile Include="HashMap\IMap.fsi" />
    <Compile Include="HashMap\IMap.fs" />
    <Compile Include="HashMap\IMapOption.fsi" />
    <Compile Include="HashMap\IMapOption.fs" />
    <Compile Include="HashMap\IMapTuple.fsi" />
    <Compile Include="HashMap\IMapTuple.fs" />
    <Compile Include="HashMap\HashMapCE.fsi" />
    <Compile Include="HashMap\HashMapCE.fs" />
    <Compile Include="SortedMap\SortedMapTypes.fs" />
    <Compile Include="SortedMap\SortedMap.CustomComparers.fsi">
      <DependentUpon>SortedMap.fsi</DependentUpon>
    </Compile>
    <Compile Include="SortedMap\SortedMap.CustomComparers.fs">
      <DependentUpon>SortedMap.fs</DependentUpon>
    </Compile>
    <Compile Include="SortedMap\SortedMap.fsi" />
    <Compile Include="SortedMap\SortedMap.fs" />
    <Compile Include="SortedMap\SortedMapOption.fsi" />
    <Compile Include="SortedMap\SortedMapOption.fs" />
    <Compile Include="SortedMap\SortedMapTuple.fsi" />
    <Compile Include="SortedMap\SortedMapTuple.fs" />
    <Compile Include="SortedMap\SortedMap.Extensions.fsi">
      <DependentUpon>SortedMap.fsi</DependentUpon>
    </Compile>
    <Compile Include="SortedMap\SortedMap.Extensions.fs">
      <DependentUpon>SortedMap.fs</DependentUpon>
    </Compile>
    <Compile Include="SortedMap\SortedMapCE.fsi" />
    <Compile Include="SortedMap\SortedMapCE.fs" />
    <Compile Include="Stack.fs" />
    <Compile Include="ImmutableList.fs" />
    <Compile Include="Queue.fs" />
    <Compile Include="IndexedSeq.fs" />
    <Compile Include="Sets.fs" />
    <Compile Include="ComputationExpressions.fsi" />
    <Compile Include="ComputationExpressions.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Collections.Immutable" />
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
