<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
    <AssemblyName>$(AssemblyBaseName)</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <AzureCosmosDisableNewtonsoftJsonCheck>True</AzureCosmosDisableNewtonsoftJsonCheck>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>FSharp.Collections.Immutable</PackageId>
    <Title>FSharp.Collections.Immutable</Title>
    <Summary>F# API for using Microsoft Azure Cosmos DB service via NoSQL API</Summary>
    <Description>Provides extension methods for the FeedIterator and computation expressions to build operations</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <Tailcalls>true</Tailcalls>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Helper.fs" />
    <Compile Include="FlatList.fsi" />
    <Compile Include="FlatList.fs" />
    <Compile Include="Stack.fs" />
    <Compile Include="ImmutableList.fs" />
    <Compile Include="Queue.fs" />
    <Compile Include="IndexedSeq.fs" />
    <Compile Include="Maps.fs" />
    <Compile Include="Sets.fs" />
    <Compile Include="Seq.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Collections.Immutable" />
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Label="InternalsVisibleToProjects">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>FSharp.Collections.Immutable.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
