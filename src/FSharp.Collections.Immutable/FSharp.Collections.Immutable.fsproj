<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>$(AssemblyBaseName)</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>FSharp.Collections.Immutable</PackageId>
    <Title>FSharp.Collections.Immutable</Title>
    <Description>F# bindings for System.Collections.Immutable</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <Tailcalls>true</Tailcalls>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="ImmutableCollectionUtil.fs" />
    <Compile Include="FlatList.fs" />
    <Compile Include="Stack.fs" />
    <Compile Include="ImmutableList.fs" />
    <Compile Include="Queue.fs" />
    <Compile Include="IndexedSeq.fs" />
    <Compile Include="Maps.fs" />
    <Compile Include="Sets.fs" />
    <Compile Include="Seq.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Collections.Immutable" />
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    The package requires the FSharp.Core and System.Collections.Immutable versions that 1.0.0 required,
    not the ones the repository builds with: a project that references an older version than the package
    requires gets NU1605 (package downgrade), which the SDK treats as an error.
  -->
  <ItemGroup>
    <PackageReference Update="FSharp.Core" VersionOverride="4.7.0" />
    <PackageReference Update="System.Collections.Immutable" VersionOverride="1.7.0" />
  </ItemGroup>

</Project>
