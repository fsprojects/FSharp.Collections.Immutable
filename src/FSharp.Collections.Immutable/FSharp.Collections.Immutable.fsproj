<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>$(AssemblyBaseName)</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>FSharp.Collections.Immutable</PackageId>
    <Title>FSharp.Collections.Immutable</Title>
    <Description>F# bindings for System.Collections.Immutable</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <Tailcalls>true</Tailcalls>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests call internal algorithms directly, where reaching a case through a public function would need arrays
         too large for memory (the bounds of the chunks of a parallel loop, for example) -->
    <InternalsVisibleTo Include="$(AssemblyBaseName).Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Helper\ImmutableCollectionUtil.fs" />
    <Compile Include="Helper\Comparers.fs" />
    <Compile Include="Helper\ErrorStrings.fs" />
    <Compile Include="Helper\Raise.fs" />
    <Compile Include="Helper\ArrayChecks.fs" />
    <Compile Include="Helper\Arrays.fs" />
    <Compile Include="Helper\ParallelArrays.fs" />
    <Compile Include="Helper\ListChecks.fs" />
    <Compile Include="Helper\ListArrays.fs" />
    <Compile Include="Helper\Snapshot.fs" />
    <Compile Include="Helper\Collectors.fs" />
    <Compile Include="Helper\Lengths.fs" />
    <Compile Include="Helper\DescendingSorts.fs" />
    <Compile Include="Helper\ListRanges.fs" />
    <Compile Include="Helper\StackConstruction.fs" />
    <Compile Include="FlatList\FlatListTypes.fs" />
    <Compile Include="FlatList\FlatList.fsi" />
    <Compile Include="FlatList\FlatList.fs" />
    <Compile Include="FlatList\FlatListOption.fsi" />
    <Compile Include="FlatList\FlatListOption.fs" />
    <Compile Include="FlatList\FlatListTuple.fsi" />
    <Compile Include="FlatList\FlatListTuple.fs" />
    <Compile Include="FlatList\FlatListBuilder.fsi" />
    <Compile Include="FlatList\FlatListBuilder.fs" />
    <Compile Include="FlatList\FlatListCE.fsi" />
    <Compile Include="FlatList\FlatListCE.fs" />
    <Compile Include="IndexedList\IndexedListTypes.fs" />
    <Compile Include="IndexedList\IndexedList.fsi" />
    <Compile Include="IndexedList\IndexedList.fs" />
    <Compile Include="IndexedList\IndexedListOption.fsi" />
    <Compile Include="IndexedList\IndexedListOption.fs" />
    <Compile Include="IndexedList\IndexedListTuple.fsi" />
    <Compile Include="IndexedList\IndexedListTuple.fs" />
    <Compile Include="IndexedList\IIndexedList.fsi" />
    <Compile Include="IndexedList\IIndexedList.fs" />
    <Compile Include="IndexedList\IIndexedListOption.fsi" />
    <Compile Include="IndexedList\IIndexedListOption.fs" />
    <Compile Include="IndexedList\IIndexedListTuple.fsi" />
    <Compile Include="IndexedList\IIndexedListTuple.fs" />
    <Compile Include="IndexedList\IndexedListBuilder.fsi" />
    <Compile Include="IndexedList\IndexedListBuilder.fs" />
    <Compile Include="IndexedList\IndexedListCE.fsi" />
    <Compile Include="IndexedList\IndexedListCE.fs" />
    <Compile Include="Stack\StackTypes.fs" />
    <Compile Include="Stack\Stack.fsi" />
    <Compile Include="Stack\Stack.fs" />
    <Compile Include="Stack\StackOption.fsi" />
    <Compile Include="Stack\StackOption.fs" />
    <Compile Include="Stack\StackTuple.fsi" />
    <Compile Include="Stack\StackTuple.fs" />
    <Compile Include="Stack\IStack.fsi" />
    <Compile Include="Stack\IStack.fs" />
    <Compile Include="Stack\IStackOption.fsi" />
    <Compile Include="Stack\IStackOption.fs" />
    <Compile Include="Stack\IStackTuple.fsi" />
    <Compile Include="Stack\IStackTuple.fs" />
    <Compile Include="Stack\StackCE.fsi" />
    <Compile Include="Stack\StackCE.fs" />
    <Compile Include="Queue.fs" />
    <Compile Include="Maps.fs" />
    <Compile Include="Sets.fs" />
    <Compile Include="ComputationExpressions.fsi" />
    <Compile Include="ComputationExpressions.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Collections.Immutable" />
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
