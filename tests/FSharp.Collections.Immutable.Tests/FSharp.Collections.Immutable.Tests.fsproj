<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>$(AssemblyBaseName).Tests</AssemblyName>

    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Helpers.fs" />
    <Compile Include="FlatList\FlatListTestBase.fs" />
    <Compile Include="FlatList\CreationTests.fs" />
    <Compile Include="FlatList\BuilderTests.fs" />
    <Compile Include="FlatList\BasicOperationsTests.fs" />
    <Compile Include="FlatList\ManipulationTests.fs" />
    <Compile Include="FlatList\FilterMapTests.fs" />
    <Compile Include="FlatList\IterationTests.fs" />
    <Compile Include="FlatList\SearchTests.fs" />
    <Compile Include="FlatList\FoldTests.fs" />
    <Compile Include="FlatList\GroupingTests.fs" />
    <Compile Include="FlatList\PairOperationTests.fs" />
    <Compile Include="FlatList\SortTests.fs" />
    <Compile Include="FlatList\UtilityTests.fs" />
    <Compile Include="Stack.fs" />
    <Compile Include="ImmutableList.fs" />
    <Compile Include="Queue.fs" />
    <Compile Include="IndexedSeq.fs" />
    <Compile Include="Maps.fs" />
    <Compile Include="Sets.fs" />
    <Compile Include="Attributes.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest" />
    <PackageReference Include="Unquote" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FSharp.Collections.Immutable\FSharp.Collections.Immutable.fsproj" />
  </ItemGroup>

</Project>
