<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>$(AssemblyBaseName).Tests</AssemblyName>

    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="testconfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Assert.fs" />
    <Compile Include="TestCategories.fs" />
    <Compile Include="AssertExtensionsTests.fs" />
    <Compile Include="Contracts\Mirror.fs" />
    <Compile Include="Contracts\ExceptionAssert.fs" />
    <Compile Include="Contracts\Inputs.fs" />
    <Compile Include="Contracts\OverrideAssert.fs" />
    <Compile Include="TestCategoriesTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="Unquote" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FSharp.Collections.Immutable\FSharp.Collections.Immutable.fsproj" />
  </ItemGroup>

</Project>
