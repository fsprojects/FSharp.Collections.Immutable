<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>$(AssemblyBaseName).Tests</AssemblyName>

    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The F# compiler fails now and then with "FS0073: internal error: Undefined or unsolved type variable: 'C" while it
      compiles this project in Release (the generic contract classes, such as SeqLikeAccessContract<'C>). The error is
      intermittent, it comes more often on runners with few cores, and it disappears when the compiler works sequentially:
      0 failures in 72 builds, where 6 of 66 builds failed without the switch. The switch costs about one second per build.
      The compiler marks the switch as meant for tests only (warning FS0075), so the warning is silenced.
      Reported to the compiler: https://github.com/dotnet/fsharp/issues/20812. Remove the switch when that issue is fixed.
    -->
    <ParallelCompilation>false</ParallelCompilation>
    <NoWarn>$(NoWarn);FS0075</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="testconfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Assert.fs" />
    <Compile Include="TestCategories.fs" />
    <Compile Include="AssertExtensionsTests.fs" />
    <Compile Include="Contracts\Mirror.fs" />
    <Compile Include="Contracts\ExceptionAssert.fs" />
    <Compile Include="Contracts\Inputs.fs" />
    <Compile Include="Contracts\OverrideAssert.fs" />
    <Compile Include="Contracts\AllocationAssert.fs" />
    <Compile Include="Contracts\ContractBase.fs" />
    <Compile Include="Contracts\SeqOps.fs" />
    <Compile Include="Contracts\SeqLike\SeqLikeAccessContract.fs" />
    <Compile Include="Contracts\SeqLike\SeqLikeSearchContract.fs" />
    <Compile Include="Contracts\SeqLike\SeqLikeTransformationContract.fs" />
    <Compile Include="Contracts\SeqLike\SeqLikeFoldingContract.fs" />
    <Compile Include="Contracts\SeqLike\SeqLikePartitioningContract.fs" />
    <Compile Include="Contracts\SeqLike\SeqLikeSortingContract.fs" />
    <Compile Include="Contracts\SeqLike\SeqLikeRandomContract.fs" />
    <Compile Include="Contracts\SeqLike\SeqLikeContract.fs" />
    <Compile Include="Contracts\SeqCreationContract.fs" />
    <Compile Include="Contracts\IndexedContract.fs" />
    <Compile Include="Contracts\StableSortContract.fs" />
    <Compile Include="Contracts\CostContract.fs" />
    <Compile Include="TestCategoriesTests.fs" />
    <Compile Include="FlatList\FlatListOps.fs" />
    <Compile Include="FlatList\FlatListAssert.fs" />
    <Compile Include="FlatList\FlatListOracles.fs" />
    <Compile Include="FlatList\FlatListContractTests.fs" />
    <Compile Include="FlatList\FlatListTests.fs" />
    <Compile Include="FlatList\FlatListSearchTests.fs" />
    <Compile Include="FlatList\FlatListBuilderTests.fs" />
    <Compile Include="FlatList\FlatListComputationExpressionTests.fs" />
    <Compile Include="FlatList\FlatListOptionTests.fs" />
    <Compile Include="FlatList\FlatListTupleTests.fs" />
    <Compile Include="FlatList\FlatListParallelTests.fs" />
    <Compile Include="FlatList\FlatListParallelOptionTests.fs" />
    <Compile Include="FlatList\FlatListParallelTupleTests.fs" />
    <Compile Include="IndexedList\ListMemberCases.fs" />
    <Compile Include="IndexedList\ListMembersContract.fs" />
    <Compile Include="IndexedList\IndexedListOps.fs" />
    <Compile Include="IndexedList\IIndexedListOps.fs" />
    <Compile Include="IndexedList\IndexedListContractTests.fs" />
    <Compile Include="IndexedList\IndexedListTests.fs" />
    <Compile Include="IndexedList\IndexedListRangeTests.fs" />
    <Compile Include="IndexedList\IIndexedListTests.fs" />
    <Compile Include="IndexedList\IndexedListBuilderTests.fs" />
    <Compile Include="IndexedList\IndexedListComputationExpressionTests.fs" />
    <Compile Include="IndexedList\IndexedListOptionTests.fs" />
    <Compile Include="IndexedList\IndexedListTupleTests.fs" />
    <Compile Include="IndexedList\IIndexedListOptionTests.fs" />
    <Compile Include="IndexedList\IIndexedListTupleTests.fs" />
    <Compile Include="Stack\StackOps.fs" />
    <Compile Include="Stack\IStackOps.fs" />
    <Compile Include="Stack\StackContractTests.fs" />
    <Compile Include="Stack\StackTests.fs" />
    <Compile Include="Stack\IStackTests.fs" />
    <Compile Include="Stack\StackComputationExpressionTests.fs" />
    <Compile Include="Stack\StackOptionTests.fs" />
